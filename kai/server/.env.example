# מפתח OpenAI — נדרש בפועל החל משלב 2 (תמלול/Whisper, routes/transcribe.js)
# ומשלב 3 (Generation, routes/generate.js). בלעדיו, שני ה-routes האלה
# ממשיכים להחזיר mock מסומן (_mock:true) ולא קורסים.
OPENAI_API_KEY=

# פורט השרת (אופציונלי — ברירת המחדל היא 3001)
PORT=3001

# המקור המותר ל-CORS — כתובת ה-Vite dev server בפיתוח מקומי (אופציונלי)
CORS_ORIGIN=http://localhost:5173
